# Publieke URL van de site (gebruikt voor SEO, sitemap en betaal-redirects)
NEXT_PUBLIC_SITE_URL=https://www.devoordeelmarkt.nl

# Mollie — laat leeg voor demomodus (gesimuleerde betaalomgeving).
# Test-key: test_xxx  |  Live-key: live_xxx  →  https://my.mollie.com/dashboard/developers/api-keys
MOLLIE_API_KEY=

# Tilroy — laat leeg voor de ingebouwde demo-catalogus.
TILROY_API_KEY=
TILROY_API_URL=https://api.tilroy.com
TILROY_PRODUCTS_ENDPOINT=/products
TILROY_SHOPS_ENDPOINT=/shops
TILROY_SALES_ENDPOINT=/sales

# KV (Upstash/Vercel KV) — orders + door het dashboard beheerde content.
# Leeg = orders lokaal in .data/orders/ en geen dashboard-content.
# Let op: dezelfde URL/token moeten in het dashboard-project (dashboardvdm)
# worden gezet als VDMSITE_KV_REST_API_URL / VDMSITE_KV_REST_API_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
