# Publieke URL van de site (gebruikt voor SEO, sitemap en betaal-redirects)
NEXT_PUBLIC_SITE_URL=https://www.devoordeelmarkt.nl

# Mollie — laat leeg voor demomodus (gesimuleerde betaalomgeving).
# Test-key: test_xxx  |  Live-key: live_xxx  →  https://my.mollie.com/dashboard/developers/api-keys
MOLLIE_API_KEY=

# VDM-dashboard — gedeelde voorraad-hub (echte Tilroy Stock API) en centrale
# fulfilment. Alleen aanpassen bij een andere dashboard-URL.
DASHBOARD_API_URL=https://dashboardvdm.vercel.app

# Trustpilot — laat leeg om de reviewwidgets uit te zetten.
# Business unit-id vind je in je Trustpilot-account onder Integrations.
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
NEXT_PUBLIC_TRUSTPILOT_DOMAIN=devoordeelmarkt.nl
# Optioneel: met een API-sleutel komt het gemiddelde cijfer in de structured
# data (sterren in Google). Zonder sleutel tonen we bewust géén rating.
TRUSTPILOT_API_KEY=

# Opslag voor bestellingen + door het dashboard beheerde content.
# Leeg = orders lokaal in .data/orders/ en geen dashboard-content.
#
# Optie 1 — Redis via TCP (Vercel Marketplace → Redis; wordt automatisch gezet):
REDIS_URL=
#
# Optie 2 — REST (Vercel KV / Upstash REST):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Let op: het dashboard (dashboardvdm) leest dezelfde store mee en moet dus
# dezelfde verbinding krijgen — bij Redis-TCP is dat de REDIS_URL.
